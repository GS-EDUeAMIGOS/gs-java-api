# ==============================================================================
# ViaCidadã API - Exemplo de Variáveis de Ambiente (.env.example)
# ==============================================================================
# NUNCA versione senhas reais! Copie este arquivo para .env (ignorado pelo Git)
# ou defina estas variáveis no seu sistema / IDE / Docker / Azure.

# Perfil ativo do Spring Boot: "h2" (desenvolvimento local) ou "oracle" (banco FIAP)
SPRING_PROFILES_ACTIVE=oracle

# ------------------------------------------------------------------------------
# Banco de Dados Oracle (Configurado pelo Kenji em gs-database)
# ------------------------------------------------------------------------------
ORACLE_DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
ORACLE_DB_USERNAME=rmXXXXXX
ORACLE_DB_PASSWORD=sua_senha_aqui
ORACLE_DB_DRIVER=oracle.jdbc.OracleDriver

# Estratégia do Hibernate no Oracle: manter "validate" ou "none" para não apagar
# nem alterar as tabelas e constraints criadas pelos scripts SQL do banco!
ORACLE_DDL_AUTO=validate
ORACLE_SHOW_SQL=false
ORACLE_POOL_MAX_SIZE=5
ORACLE_POOL_MIN_IDLE=1
ORACLE_CONNECTION_TIMEOUT_MS=20000

# ------------------------------------------------------------------------------
# Segurança JWT & CORS
# ------------------------------------------------------------------------------
JWT_SECRET=substitua_por_uma_chave_secreta_de_pelo_menos_256_bits_aqui
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# Integração SPTrans Olho Vivo
# ------------------------------------------------------------------------------
SPTRANS_BASE_URL=https://api.olhovivo.sptrans.com.br/v2.1
SPTRANS_TOKEN=seu_token_sptrans_olho_vivo_aqui
